# Copy this file to .env.local and fill in your own values. NEVER commit .env.local.

# Required for real AI recommendations (get a key at https://aistudio.google.com/apikey).
# Without it the app shows a clearly labeled non-AI fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional: shared "catch" counts via Google Cloud Firestore.
# Leave empty to use clearly labeled demo numbers instead.
# Locally also run: gcloud auth application-default login
FIRESTORE_PROJECT_ID=
